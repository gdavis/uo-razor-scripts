if skill 'tasteidentification' >= 120
    overhead 'At Taste ID Max'
    wait 5000
    loop
endif

if find tasteTrainingTarget self 
else
    overhead 'Select training target'
    setvar tasteTrainingTarget
endif

if targetexists
    clearall 
endif

skill 'tasteidentification'
waitfortarget 500
target tasteTrainingTarget
wait 500

if insysmsg 'you are unable'
    wait 1000
else
    wait 1000
endif

loop